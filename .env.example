# Copy to .env and fill in. Never commit .env.

# Database and queue
DATABASE_URL=postgres://novra:novra@postgres:5432/novra
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=novra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=novra

# File storage (local disk volume)
STORAGE_DIR=/data/storage

# Public URL of the app (used for cookies)
APP_URL=http://localhost:3000

# First operator account (used by `npm run user:create` and on first container start)
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# AI text provider: "anthropic" (real) or "mock" (TEST only, clearly labelled output)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Server-side refusal fallbacks ("default" or "off")
ANTHROPIC_FALLBACKS=default

# Image provider: fal.ai. Leave empty to run without generated images.
FAL_KEY=
FAL_MODEL=fal-ai/flux/dev
# Estimated cost per generated image in USD (for the cost guard)
FAL_COST_PER_IMAGE=0.025
